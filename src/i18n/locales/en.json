  "exerciseDesc": {
    "squat": "Stand shoulder-width, brace your core, sit your hips back and down until thighs are parallel, then drive back up through your heels.",
    "lunge": "Step forward, lower the back knee toward the floor with an upright torso, then push back to standing and switch legs.",
    "leg_press": "Place feet shoulder-width on the platform, lower the weight until knees reach 90°, then press back up without locking out.",
    "romanian_deadlift": "With a slight knee bend, hinge at the hips and lower the bar along your legs until you feel the hamstrings stretch, then return upright.",
    "bench_press": "Lower the bar to mid-chest with elbows at about 45°, then press it back up until arms are extended.",
    "pushup": "Hands under shoulders, body in a straight line — lower your chest to the floor and press back up.",
    "incline_dumbbell_press": "On an incline bench, press the dumbbells from shoulder level until arms are extended, then lower with control.",
    "pullup": "Hang from the bar with an overhand grip and pull your chin above the bar, then lower slowly.",
    "lat_pulldown": "Grip the bar wide, pull it to your upper chest while keeping the torso upright, then release with control.",
    "barbell_row": "Hinge forward with a flat back and pull the bar to your lower ribs, squeezing the shoulder blades together.",
    "overhead_press": "Press the bar from shoulder height straight overhead, keeping your core tight and ribs down.",
    "lateral_raise": "With a slight elbow bend, raise the dumbbells out to shoulder height and lower slowly.",
    "biceps_curl": "Keep elbows pinned to your sides and curl the weight up, then lower fully under control.",
    "triceps_dip": "Support yourself on parallel bars or a bench, bend the elbows to 90°, then press back up.",
    "plank": "Forearms on the floor, body in one straight line — hold while breathing steadily.",
    "crunch": "Lie on your back with knees bent, curl your shoulder blades off the floor, then lower slowly.",
    "hip_thrust": "Upper back on a bench, drive your hips up by squeezing the glutes until your body forms a line, then lower.",
    "deadlift": "With a flat back, grip the bar and stand up by driving through the legs and hips, then lower it along the same path.",
    "goblet_squat": "Hold a dumbbell at your chest, squat down keeping your torso upright, then drive back up.",
    "split_squat": "One foot forward, one behind — lower the back knee toward the floor, then press up through the front heel.",
    "glute_bridge": "Lie on your back with knees bent and lift your hips by squeezing the glutes, then lower slowly.",
    "dumbbell_row": "Support one hand on a bench, pull the dumbbell to your hip with a flat back, then lower with control."
  }
}