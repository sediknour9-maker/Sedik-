  "exerciseDesc": {
    "squat": "Schulterbreit stehen, Rumpf anspannen, Hüfte nach hinten-unten absenken bis die Oberschenkel parallel sind, dann über die Fersen wieder hochdrücken.",
    "lunge": "Einen Schritt nach vorn machen, das hintere Knie Richtung Boden senken, Oberkörper aufrecht — dann zurückdrücken und Bein wechseln.",
    "leg_press": "Füße schulterbreit auf die Plattform, Gewicht bis ca. 90° Kniewinkel absenken und ohne Durchstrecken wieder hochdrücken.",
    "romanian_deadlift": "Mit leicht gebeugten Knien aus der Hüfte vorbeugen, die Stange nah an den Beinen absenken bis die Beinrückseite zieht, dann aufrichten.",
    "bench_press": "Stange zur Brustmitte absenken, Ellbogen ca. 45° zum Körper, dann kraftvoll nach oben drücken.",
    "pushup": "Hände unter den Schultern, Körper in einer Linie — Brust zum Boden senken und wieder hochdrücken.",
    "incline_dumbbell_press": "Auf der Schrägbank die Kurzhanteln von Schulterhöhe nach oben drücken und kontrolliert absenken.",
    "pullup": "Im Obergriff an die Stange hängen, Kinn über die Stange ziehen und langsam ablassen.",
    "lat_pulldown": "Stange breit greifen, zur oberen Brust ziehen, Oberkörper aufrecht halten, kontrolliert zurücklassen.",
    "barbell_row": "Mit geradem Rücken vorbeugen, Stange zu den unteren Rippen ziehen und Schulterblätter zusammendrücken.",
    "overhead_press": "Stange von Schulterhöhe senkrecht über den Kopf drücken, Rumpf fest, Rippen unten.",
    "lateral_raise": "Mit leicht gebeugten Ellbogen die Kurzhanteln seitlich bis Schulterhöhe heben und langsam senken.",
    "biceps_curl": "Ellbogen am Körper fixieren, Gewicht nach oben curlen und vollständig kontrolliert absenken.",
    "triceps_dip": "Am Barren oder an der Bank abstützen, Ellbogen bis 90° beugen und wieder hochdrücken.",
    "plank": "Unterarme am Boden, Körper in einer geraden Linie — Position halten und ruhig atmen.",
    "crunch": "Rückenlage mit angewinkelten Beinen, Schulterblätter vom Boden abrollen und langsam absenken.",
    "hip_thrust": "Oberer Rücken auf der Bank, Hüfte durch Anspannen des Gesäßes nach oben drücken bis der Körper eine Linie bildet.",
    "deadlift": "Mit geradem Rücken die Stange greifen und durch Bein- und Hüftstreckung aufstehen, auf gleichem Weg absenken.",
    "goblet_squat": "Kurzhantel vor der Brust halten, mit aufrechtem Oberkörper in die Hocke gehen und wieder hochdrücken.",
    "split_squat": "Ein Fuß vorn, einer hinten — das hintere Knie Richtung Boden senken und über die vordere Ferse hochdrücken.",
    "glute_bridge": "Rückenlage mit angewinkelten Beinen, Hüfte durch Anspannen des Gesäßes anheben und langsam senken.",
    "dumbbell_row": "Mit einer Hand auf der Bank abstützen, die Kurzhantel mit geradem Rücken zur Hüfte ziehen und kontrolliert absenken."
  }
}