  "exerciseDesc": {
    "squat": "قف بعرض الكتفين، شد جذعك، انزل بالوركين للخلف والأسفل حتى يتوازى الفخذان مع الأرض ثم ادفع للأعلى عبر الكعبين.",
    "lunge": "اخطُ للأمام وانزل بالركبة الخلفية نحو الأرض مع جذع مستقيم، ثم ادفع للعودة وبدّل الساقين.",
    "leg_press": "ضع القدمين بعرض الكتفين على المنصة، انزل حتى زاوية 90° في الركبتين ثم ادفع دون قفل الركبتين.",
    "romanian_deadlift": "مع ثني خفيف في الركبتين، انحنِ من الوركين وأنزل البار قريبًا من الساقين حتى تشعر بشد الخلفية ثم اعتدل.",
    "bench_press": "أنزل البار إلى منتصف الصدر والمرفقان بزاوية 45° تقريبًا ثم ادفع للأعلى حتى تمتد الذراعان.",
    "pushup": "اليدان تحت الكتفين والجسم في خط مستقيم — انزل بالصدر نحو الأرض ثم ادفع للأعلى.",
    "incline_dumbbell_press": "على مقعد مائل، ادفع الدمبل من مستوى الكتفين حتى تمتد الذراعان ثم انزل ببطء.",
    "pullup": "تعلق بالبار بقبضة علوية واسحب ذقنك فوق البار ثم انزل ببطء.",
    "lat_pulldown": "أمسك البار بقبضة واسعة واسحبه نحو أعلى الصدر مع جذع مستقيم ثم أعده بتحكم.",
    "barbell_row": "انحنِ بظهر مستقيم واسحب البار نحو أسفل الأضلاع مع ضم لوحي الكتف.",
    "overhead_press": "ادفع البار من مستوى الكتفين فوق الرأس مباشرة مع شد الجذع.",
    "lateral_raise": "مع ثني خفيف في المرفقين، ارفع الدمبل جانبًا حتى مستوى الكتفين وانزل ببطء.",
    "biceps_curl": "ثبّت المرفقين على الجانبين وارفع الوزن ثم أنزله بالكامل بتحكم.",
    "triceps_dip": "استند على المتوازي أو مقعد، اثنِ المرفقين حتى 90° ثم ادفع للأعلى.",
    "plank": "الساعدان على الأرض والجسم في خط واحد — حافظ على الوضعية مع تنفس هادئ.",
    "crunch": "استلقِ على ظهرك مع ثني الركبتين، ارفع لوحي الكتف عن الأرض ثم انزل ببطء.",
    "hip_thrust": "أعلى الظهر على مقعد، ادفع الوركين للأعلى بشد المؤخرة حتى يستقيم الجسم ثم انزل.",
    "deadlift": "بظهر مستقيم أمسك البار وقف بدفع الساقين والوركين ثم أنزله على نفس المسار.",
    "goblet_squat": "أمسك دمبل أمام صدرك وانزل في وضع السكوات مع جذع مستقيم ثم ادفع للأعلى.",
    "split_squat": "قدم أمامية وأخرى خلفية — انزل بالركبة الخلفية نحو الأرض ثم ادفع عبر كعب القدم الأمامية.",
    "glute_bridge": "استلقِ على ظهرك مع ثني الركبتين وارفع الوركين بشد المؤخرة ثم انزل ببطء.",
    "dumbbell_row": "استند بيد على مقعد واسحب الدمبل نحو الورك بظهر مستقيم ثم أنزله بتحكم."
  }
}