/**
 * ALERO GmbH – Recruiting-Chat-Widget
 * Einbinden: <script src="{{ base_url }}/demo/alero/widget.js"></script>
 * Das Widget erscheint als Button unten rechts auf jeder Seite.
 */
(function() {
  'use strict';

  const BASE_URL     = "{{ base_url }}";
  const TENANT_SHORT = "{{ tenant_short }}";
  const PRIMARY      = "{{ primary_color }}";
  const DARK         = "{{ dark_color }}";
  const AGENT_NAME   = "{{ agent_name }}";
  const COMPANY      = "{{ company_name }}";

  // Doppeltes Einbinden verhindern
  if (window.__ALERO_WIDGET__) return;
  window.__ALERO_WIDGET__ = true;

  let conversationId = null;
  let isOpen         = false;

  // ── CSS ──────────────────────────────────────────────────────────────────
  const style = document.createElement('style');
  style.textContent = `
    #__aw-widget { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }

    #__aw-btn {
      position: fixed; bottom: 24px; right: 24px; z-index: 99999;
      width: 60px; height: 60px;
      background: ${PRIMARY}; border-radius: 50%;
      box-shadow: 0 4px 20px rgba(0,0,0,.25);
      cursor: pointer; display: flex; align-items: center; justify-content: center;
      border: none; transition: transform .2s, box-shadow .2s;
    }
    #__aw-btn:hover { transform: scale(1.08); box-shadow: 0 6px 28px rgba(0,0,0,.3); }
    #__aw-btn svg   { fill: white; width: 26px; height: 26px; }
    #__aw-badge {
      position: absolute; top: -4px; right: -4px;
      background: #4ade80; width: 14px; height: 14px; border-radius: 50%;
      border: 2px solid white; animation: __aw-pulse 2s infinite;
    }
    @keyframes __aw-pulse {
      0%,100% { box-shadow: 0 0 0 0 rgba(74,222,128,.4); }
      50%      { box-shadow: 0 0 0 5px rgba(74,222,128,0); }
    }

    #__aw-panel {
      position: fixed; bottom: 96px; right: 24px; z-index: 99998;
      width: 360px; max-height: 540px;
      background: white; border-radius: 16px;
      box-shadow: 0 8px 40px rgba(0,0,0,.18);
      display: flex; flex-direction: column; overflow: hidden;
      transition: opacity .25s, transform .25s;
      border: 1px solid rgba(0,0,0,.08);
    }
    #__aw-panel.hidden { opacity: 0; transform: translateY(12px) scale(.97); pointer-events: none; }

    #__aw-topbar {
      background: ${PRIMARY}; padding: 14px 16px;
      display: flex; align-items: center; gap: 10px;
    }
    #__aw-topbar .av {
      width: 36px; height: 36px; background: white; border-radius: 50%;
      display: flex; align-items: center; justify-content: center; font-size: 1.1rem;
    }
    #__aw-topbar .info strong { color: white; font-size: .9rem; display: block; }
    #__aw-topbar .info span   { color: rgba(255,255,255,.8); font-size: .75rem; }
    #__aw-close {
      margin-left: auto; background: rgba(255,255,255,.2); border: none;
      color: white; width: 28px; height: 28px; border-radius: 50%;
      cursor: pointer; font-size: 1rem; display: flex; align-items: center; justify-content: center;
    }
    #__aw-close:hover { background: rgba(255,255,255,.35); }

    #__aw-messages {
      flex: 1; overflow-y: auto; padding: 14px;
      display: flex; flex-direction: column; gap: 10px;
      max-height: 360px;
      scroll-behavior: smooth;
    }
    #__aw-messages::-webkit-scrollbar { width: 3px; }
    #__aw-messages::-webkit-scrollbar-thumb { background: #e5e7eb; border-radius: 2px; }

    .__aw-row        { display: flex; gap: 7px; align-items: flex-end; }
    .__aw-row.user   { flex-direction: row-reverse; }
    .__aw-av         { width: 26px; height: 26px; border-radius: 50%; display: flex;
                       align-items: center; justify-content: center; font-size: .75rem;
                       flex-shrink: 0; }
    .__aw-av.agent   { background: ${PRIMARY}; color: white; }
    .__aw-av.user    { background: ${DARK}; color: white; }
    .__aw-bubble     { max-width: 80%; padding: 9px 13px; border-radius: 14px;
                       font-size: .85rem; line-height: 1.5; }
    .__aw-row.agent .__aw-bubble {
      background: #f3f4f6; color: #1f2937;
      border: 1px solid #e5e7eb; border-bottom-left-radius: 4px; }
    .__aw-row.user  .__aw-bubble {
      background: ${PRIMARY}; color: white; border-bottom-right-radius: 4px; }

    .__aw-typing { display: flex; gap: 4px; padding: 3px 0; }
    .__aw-typing span {
      width: 6px; height: 6px; background: #9ca3af;
      border-radius: 50%; animation: __aw-bounce .9s infinite; }
    .__aw-typing span:nth-child(2) { animation-delay: .15s; }
    .__aw-typing span:nth-child(3) { animation-delay: .3s; }
    @keyframes __aw-bounce {
      0%,80%,100% { transform: translateY(0); }
      40%          { transform: translateY(-5px); }
    }

    #__aw-inputrow {
      padding: 10px 12px; border-top: 1px solid #e5e7eb;
      display: flex; gap: 7px; background: white;
    }
    #__aw-input {
      flex: 1; padding: 9px 12px;
      border: 1.5px solid #e5e7eb; border-radius: 22px;
      font-size: .85rem; outline: none; font-family: inherit;
    }
    #__aw-input:focus { border-color: ${PRIMARY}; box-shadow: 0 0 0 3px rgba(200,40,30,.1); }
    #__aw-send {
      width: 38px; height: 38px; background: ${PRIMARY};
      border: none; border-radius: 50%; cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      flex-shrink: 0; transition: background .2s;
    }
    #__aw-send:hover:not(:disabled) { background: #a01f16; }
    #__aw-send:disabled { background: #d1d5db; cursor: not-allowed; }
    #__aw-send svg { fill: white; width: 16px; height: 16px; }

    #__aw-footer {
      text-align: center; font-size: .65rem; color: #9ca3af;
      padding: 6px 12px; background: #f9fafb;
      border-top: 1px solid #f3f4f6;
    }

    @media (max-width: 420px) {
      #__aw-panel { width: calc(100vw - 20px); right: 10px; bottom: 80px; }
    }
  `;
  document.head.appendChild(style);

  // ── HTML ─────────────────────────────────────────────────────────────────
  const wrapper = document.createElement('div');
  wrapper.id    = '__aw-widget';
  wrapper.innerHTML = `
    <button id="__aw-btn" title="${AGENT_NAME} öffnen" aria-label="Chat öffnen">
      <svg viewBox="0 0 24 24"><path d="M20 2H4c-1.1 0-2 .9-2 2v18l4-4h14c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2z"/></svg>
      <div id="__aw-badge"></div>
    </button>

    <div id="__aw-panel" class="hidden" role="dialog" aria-label="${COMPANY} Recruiting-Assistent">
      <div id="__aw-topbar">
        <div class="av">🤖</div>
        <div class="info">
          <strong>${AGENT_NAME}</strong>
          <span>${COMPANY}</span>
        </div>
        <button id="__aw-close" aria-label="Chat schließen">✕</button>
      </div>
      <div id="__aw-messages" role="log" aria-live="polite"></div>
      <div id="__aw-inputrow">
        <input id="__aw-input" type="text" placeholder="Nachricht…" autocomplete="off" />
        <button id="__aw-send" title="Senden">
          <svg viewBox="0 0 24 24"><path d="M2 21l21-9L2 3v7l15 2-15 2v7z"/></svg>
        </button>
      </div>
      <div id="__aw-footer">
        Powered by <strong>ALERO KI-Agent</strong> · Datenschutzkonform (DSGVO)
      </div>
    </div>
  `;
  document.body.appendChild(wrapper);

  // ── Logik ─────────────────────────────────────────────────────────────────
  const panel  = document.getElementById('__aw-panel');
  const msgs   = document.getElementById('__aw-messages');
  const inp    = document.getElementById('__aw-input');
  const sndBtn = document.getElementById('__aw-send');

  document.getElementById('__aw-btn').onclick   = toggleWidget;
  document.getElementById('__aw-close').onclick = toggleWidget;
  sndBtn.onclick = send;
  inp.addEventListener('keydown', e => { if (e.key === 'Enter') send(); });

  function toggleWidget() {
    isOpen = !isOpen;
    panel.classList.toggle('hidden', !isOpen);
    if (isOpen && msgs.children.length === 0) showWelcome();
    if (isOpen) inp.focus();
  }

  function addMsg(text, role) {
    const row    = document.createElement('div');
    row.className = `__aw-row ${role}`;
    row.innerHTML = `
      <div class="__aw-av ${role}">${role === 'agent' ? '🤖' : '👤'}</div>
      <div class="__aw-bubble">${escHtml(text)}</div>`;
    msgs.appendChild(row);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function showTyping() {
    const row    = document.createElement('div');
    row.className = '__aw-row agent';
    row.id        = '__aw-typing';
    row.innerHTML = `
      <div class="__aw-av agent">🤖</div>
      <div class="__aw-bubble">
        <div class="__aw-typing"><span></span><span></span><span></span></div>
      </div>`;
    msgs.appendChild(row);
    msgs.scrollTop = msgs.scrollHeight;
  }

  function hideTyping() {
    const el = document.getElementById('__aw-typing');
    if (el) el.remove();
  }

  function showWelcome() {
    addMsg(
      'Guten Tag! Ich bin Ihr digitaler Recruiting-Assistent der ALERO GmbH. ' +
      'Wie kann ich Ihnen helfen? (Bewerben, Jobs anfragen, Termin vereinbaren)',
      'agent'
    );
  }

  async function send() {
    const text = inp.value.trim();
    if (!text) return;
    inp.value = '';
    addMsg(text, 'user');
    sndBtn.disabled = true;
    showTyping();

    try {
      const res = await fetch(`${BASE_URL}/api/agent/chat`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'X-Tenant': TENANT_SHORT },
        body: JSON.stringify({ message: text, conversation_id: conversationId, tenant_short: TENANT_SHORT }),
      });
      const data = await res.json();
      conversationId = data.conversation_id;
      hideTyping();
      addMsg(data.response, 'agent');
    } catch {
      hideTyping();
      addMsg('Verbindungsfehler. Bitte versuchen Sie es erneut.', 'agent');
    } finally {
      sndBtn.disabled = false;
      inp.focus();
    }
  }

  function escHtml(str) {
    return str.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');
  }

})();
