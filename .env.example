# === Anthropic Claude API ===
ANTHROPIC_API_KEY=sk-ant-...

# === Datenbank ===
DATABASE_URL=sqlite+aiosqlite:///./sedik_agent.db
# Für Produktion: postgresql+asyncpg://user:pass@host/dbname

# === Twilio (Telefon + SMS) ===
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_PHONE_NUMBER=+49XXXXXXXXXX

# === E-Mail (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=ihre-email@firma.de
SMTP_PASSWORD=ihr-passwort
SMTP_FROM_NAME=Sedik Recruiting Agent
SMTP_FROM_EMAIL=agent@ihre-firma.de

# === Anwendung ===
APP_NAME=Sedik AI Recruiting Agent
APP_URL=https://ihre-domain.de
SECRET_KEY=ihr-geheimer-schluessel-mindestens-32-zeichen
DEBUG=false

# === Agent Verhalten ===
# Sprache des Agenten (de/en)
AGENT_LANGUAGE=de
# Max Wartezeit für Mitarbeiter-Bestätigung in Stunden
APPROVAL_TIMEOUT_HOURS=24
# Mitarbeiter-E-Mails (kommagetrennt) für Benachrichtigungen
STAFF_EMAILS=mitarbeiter1@firma.de,mitarbeiter2@firma.de
# Telefonnummern der Mitarbeiter für SMS-Benachrichtigungen
STAFF_PHONES=+49XXXXXXXXXX,+49XXXXXXXXXX
